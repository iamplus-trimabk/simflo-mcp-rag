{
  "version": "1.0.0",
  "pipeline": {
    "name": "SimFlo MCP RAG Data Pipeline",
    "description": "Universal component extraction and processing pipeline",
    "default_output_dir": "../rag_databases",
    "temp_dir": "/tmp/simflo-pipeline"
  },
  "extractors": {
    "github_cli": {
      "name": "GitHub CLI Extractor",
      "description": "Enhanced extractor using GitHub CLI for authenticated operations",
      "executable": "github_cli_extractor.py",
      "requires_gh_cli": true,
      "supported_formats": ["url", "owner/repo", "ssh"],
      "capabilities": [
        "repository_metadata",
        "similar_repository_discovery",
        "authenticated_cloning",
        "quality_analysis",
        "enhanced_extraction"
      ]
    },
    "github_basic": {
      "name": "Basic GitHub Extractor",
      "description": "Standard GitHub extractor using git commands",
      "executable": "github_extractor.py",
      "requires_gh_cli": false,
      "supported_formats": ["url"],
      "capabilities": [
        "basic_extraction",
        "component_parsing",
        "metadata_extraction"
      ]
    }
  },
  "extractor_profiles": {
    "gluestack": {
      "name": "Gluestack UI",
      "extractor": "github_cli",
      "repository": "gluestack/gluestack-ui",
      "output_path": "../rag_databases/gluestack_db/components.json",
      "post_processor": "gluestack_post_processor",
      "platform_detection": "enhanced",
      "quality_threshold": 0.7
    },
    "shadcn": {
      "name": "Shadcn UI",
      "extractor": "github_basic",
      "repository": "https://github.com/shadcn-ui/ui",
      "output_path": "../rag_databases/shadcn_db/components.json",
      "post_processor": "shadcn_post_processor",
      "platform_detection": "basic",
      "quality_threshold": 0.8
    },
    "radix_ui": {
      "name": "Radix UI",
      "extractor": "github_cli",
      "repository": "https://github.com/radix-ui/primitives",
      "output_path": "../rag_databases/radix_db/components.json",
      "post_processor": "radix_post_processor",
      "platform_detection": "enhanced",
      "quality_threshold": 0.9
    }
  },
  "post_processors": {
    "gluestack_post_processor": {
      "name": "Gluestack Post Processor",
      "description": "Gluestack-specific component enhancement",
      "platform_mapping": {
        "reactnative_indicators": ["react-native", "native", "@gluestack-style/react-native"],
        "reactjs_indicators": ["react", "next", "@gluestack-style/react"]
      },
      "categories": {
        "ui": ["button", "input", "modal", "alert", "toast", "tooltip"],
        "layout": ["box", "vstack", "hstack", "center", "divider"],
        "navigation": ["actionsheet", "avatar", "breadcrumb", "tabs"],
        "form": ["checkbox", "radio", "switch", "slider", "select"],
        "feedback": ["alert", "toast", "progress", "skeleton"],
        "data": ["table", "list", "card", "badge"]
      }
    },
    "shadcn_post_processor": {
      "name": "Shadcn Post Processor",
      "description": "Shadcn-specific component enhancement",
      "platform_mapping": {
        "reactjs_indicators": ["react", "next", "tailwind", "@radix-ui"]
      },
      "categories": {
        "ui": ["accordion", "alert", "button", "card", "dialog"],
        "form": ["input", "label", "select", "textarea", "checkbox"],
        "navigation": ["breadcrumb", "pagination", "tabs", "sheet"],
        "layout": ["aspect-ratio", "avatar", "badge", "separator"],
        "data": ["table", "calendar", "carousel", "chart"]
      }
    }
  },
  "quality_metrics": {
    "documentation_score": {
      "has_readme": 30,
      "has_package_json": 20,
      "has_tests": 25,
      "has_typescript": 25
    },
    "component_quality": {
      "has_description": 20,
      "has_types": 30,
      "has_examples": 25,
      "has_props_documentation": 25
    },
    "repository_health": {
      "recent_activity": 30,
      "contributor_count": 20,
      "star_count": 25,
      "issue_response_rate": 25
    }
  },
  "orchestration": {
    "max_concurrent_extractions": 3,
    "retry_attempts": 3,
    "retry_delay": 5,
    "timeout": 1800,
    "cleanup_temp_files": true,
    "log_level": "INFO"
  }
}