[Unit]
Description=SimFlo RAG Build Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=simflo
Group=simflo
WorkingDirectory=/opt/simflo-mcp-rag
ExecStart=/opt/simflo-mcp-rag/venv/bin/python scripts/build_service.py --daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment=PYTHONPATH=/opt/simflo-mcp-rag
Environment=LOG_LEVEL=INFO
Environment=CONFIG_DIR=/opt/simflo-mcp-rag/rag_databases/registry_config
Environment=OUTPUT_DIR=/opt/simflo-mcp-rag/rag_databases/extracted_data
Environment=HISTORY_DIR=/opt/simflo-mcp-rag/rag_databases/build_history

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/simflo-mcp-rag/rag_databases

[Install]
WantedBy=multi-user.target