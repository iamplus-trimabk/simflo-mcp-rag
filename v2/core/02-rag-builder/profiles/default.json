{
  "profile_name": "default",
  "description": "Default RAG pipeline profile for component discovery",
  "pipeline_config": {
    "extractors": ["shadcn", "gluestack", "community"],
    "registries": ["shadcn", "gluestack", "community"],
    "vector_store_config": {
      "embedding_model": "all-MiniLM-L6-v2",
      "chunk_size": 1000,
      "chunk_overlap": 200
    },
    "content_sources": {
      "github": true,
      "npm": true,
      "documentation": true
    }
  },
  "optimization": {
    "parallel_extraction": true,
    "batch_size": 10,
    "cache_enabled": true
  },
  "quality": {
    "min_component_size": 50,
    "max_component_size": 50000,
    "require_documentation": false
  }
}