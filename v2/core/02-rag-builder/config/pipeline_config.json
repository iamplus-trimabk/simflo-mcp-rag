{
  "pipeline": {
    "name": "simflo-rag-pipeline",
    "version": "2.0.0",
    "description": "CLI-first RAG pipeline for component discovery"
  },
  "registries": {
    "default_registry": "shadcn",
    "supported_registries": ["shadcn", "gluestack", "community"],
    "registry_base_path": "v2/core/00-rag-registry/registries"
  },
  "extraction": {
    "extractors_path": "v2/04-extractors/core",
    "supported_extractors": [
      "shadcn",
      "shadcn_hooks",
      "shadcn_components",
      "shadcn_blocks",
      "gluestack",
      "community",
      "documentation"
    ]
  },
  "vector_store": {
    "default_vector_store": "chromadb",
    "embedding_model": "all-MiniLM-L6-v2",
    "chunk_size": 1000,
    "chunk_overlap": 200
  },
  "content_collection": {
    "sources_path": "v2/03-content-collection",
    "supported_source_types": ["github", "npm", "documentation", "community"]
  },
  "output": {
    "formats": ["json", "table"],
    "default_format": "json",
    "timestamp_format": "ISO"
  }
}