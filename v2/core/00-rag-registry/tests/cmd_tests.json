{
  "description": "Essential test suite for registry system CLI commands",
  "tests": [
    {
      "test_name": "list_command",
      "description": "Test list command with JSON output",
      "command": "python3 v2/core/00-rag-registry/registry.py list",
      "expected_exit_code": 0,
      "expected_stdout_pattern": ".*\\[.*\\].*",
      "expected_stderr": ""
    },
    {
      "test_name": "info_command",
      "description": "Test info command for existing registry",
      "command": "python3 v2/core/00-rag-registry/registry.py info --name shadcn",
      "expected_exit_code": 0,
      "expected_stdout_pattern": ".*\"name\": \"shadcn\".*",
      "expected_stderr": ""
    },
    {
      "test_name": "search_command",
      "description": "Test search command",
      "command": "python3 v2/core/00-rag-registry/registry.py search --query \"button\" --limit 5",
      "expected_exit_code": 0,
      "expected_stdout_pattern": ".*\"query\": \"button\".*",
      "expected_stderr": ""
    },
    {
      "test_name": "status_command",
      "description": "Test status command",
      "command": "python3 v2/core/00-rag-registry/registry.py status",
      "expected_exit_code": 0,
      "expected_stdout_pattern": ".*\"total_registries\":.*",
      "expected_stderr": ""
    },
    {
      "test_name": "help_command",
      "description": "Test main help command",
      "command": "python3 v2/core/00-rag-registry/registry.py --help",
      "expected_exit_code": 0,
      "expected_stdout_pattern": ".*RAG Registry System CLI.*",
      "expected_stderr": ""
    },
    {
      "test_name": "table_format",
      "description": "Test table output format",
      "command": "python3 v2/core/00-rag-registry/registry.py list --format table",
      "expected_exit_code": 0,
      "expected_stdout_pattern": ".*total_registries.*registries.*",
      "expected_stderr": ""
    },
    {
      "test_name": "error_handling",
      "description": "Test error handling for missing required parameter",
      "command": "python3 v2/core/00-rag-registry/registry.py info",
      "expected_exit_code": 2,
      "expected_stderr_pattern": ".*required: --name.*"
    },
    {
      "test_name": "invalid_command",
      "description": "Test invalid command error handling",
      "command": "python3 v2/core/00-rag-registry/registry.py invalid_command",
      "expected_exit_code": 2,
      "expected_stderr_pattern": ".*invalid choice: 'invalid_command'.*"
    },
    {
      "test_name": "search_with_results",
      "description": "Test search command functionality (currently returns empty)",
      "command": "python3 v2/core/00-rag-registry/registry.py search --query \"button\" --limit 3 --format json",
      "expected_exit_code": 0,
      "expected_stdout_pattern": ".*\"total_results\": 0.*"
    },
    {
      "test_name": "info_nonexistent_registry",
      "description": "Test info command for non-existent registry",
      "command": "python3 v2/core/00-rag-registry/registry.py info --name nonexistent",
      "expected_exit_code": 0,
      "expected_stdout_pattern": ".*Registry 'nonexistent' not found.*"
    }
  ]
}