{
  "components": [
    {
      "id": "button",
      "name": "Button",
      "type": "component",
      "category": "interactive",
      "description": "Interactive button component with multiple variants and states",
      "properties": [
        {
          "name": "variant",
          "type": "string",
          "default_value": "primary",
          "required": true,
          "description": "Button variant style",
          "allowed_values": ["primary", "secondary", "outline", "ghost", "danger"],
          "validation": {
            "pattern": "^(primary|secondary|outline|ghost|danger)$"
          }
        },
        {
          "name": "size",
          "type": "string",
          "default_value": "md",
          "required": true,
          "description": "Button size",
          "allowed_values": ["sm", "md", "lg"],
          "validation": {
            "pattern": "^(sm|md|lg)$"
          }
        },
        {
          "name": "text",
          "type": "string",
          "default_value": "",
          "required": true,
          "description": "Button text content",
          "validation": {
            "min_length": 1,
            "max_length": 50
          }
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default_value": false,
          "required": false,
          "description": "Disable the button"
        },
        {
          "name": "loading",
          "type": "boolean",
          "default_value": false,
          "required": false,
          "description": "Show loading state"
        },
        {
          "name": "icon_left",
          "type": "string",
          "default_value": null,
          "required": false,
          "description": "Icon name to display on the left"
        },
        {
          "name": "icon_right",
          "type": "string",
          "default_value": null,
          "required": false,
          "description": "Icon name to display on the right"
        },
        {
          "name": "full_width",
          "type": "boolean",
          "default_value": false,
          "required": false,
          "description": "Make button full width"
        }
      ],
      "variants": [
        {
          "name": "primary",
          "properties": {
            "variant": "primary",
            "size": "md"
          },
          "description": "Primary button with solid background color"
        },
        {
          "name": "secondary",
          "properties": {
            "variant": "secondary",
            "size": "md"
          },
          "description": "Secondary button with alternative color"
        },
        {
          "name": "outline",
          "properties": {
            "variant": "outline",
            "size": "md"
          },
          "description": "Button with outlined style"
        },
        {
          "name": "ghost",
          "properties": {
            "variant": "ghost",
            "size": "md"
          },
          "description": "Minimal button with transparent background"
        },
        {
          "name": "danger",
          "properties": {
            "variant": "danger",
            "size": "md"
          },
          "description": "Danger button for destructive actions"
        }
      ],
      "children_component_ids": [],
      "usage_examples": [
        {
          "title": "Submit Form",
          "description": "Primary submit button for forms",
          "properties": {
            "variant": "primary",
            "size": "md",
            "text": "Submit",
            "full_width": true
          }
        },
        {
          "title": "Cancel Action",
          "description": "Secondary button for canceling actions",
          "properties": {
            "variant": "outline",
            "size": "md",
            "text": "Cancel"
          }
        },
        {
          "title": "Delete Item",
          "description": "Danger button for destructive actions",
          "properties": {
            "variant": "danger",
            "size": "sm",
            "text": "Delete",
            "icon_left": "trash"
          }
