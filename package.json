{
  "name": "simflo-figma-to-rag-pipeline",
  "version": "1.0.0",
  "description": "A comprehensive 9-step pipeline that transforms Figma designs into production-ready applications",
  "main": "v2/common/utils.js",
  "scripts": {
    "test": "python3 -m pytest v2/tests/ -v",
