{
  "test_suite": {
    "name": "API Endpoint Tests",
    "description": "Validate REST API endpoints functionality",
    "version": "1.0.0",
    "author": "SimFlo Team"
  },
  "tests": [
    {
      "test_id": "API-001",
      "name": "API Server Health Check",
      "description": "Verify API server is running and responding",
      "command": "curl -s http://127.0.0.1:8000/health",
      "expect_stdout": {"type": "contains", "value": "status"},
      "timeout": 10
    },
    {
      "test_id": "API-002",
      "name": "V1 Context Endpoints Available",
      "description": "Verify v1 context endpoints are accessible",
      "command": "curl -s http://127.0.0.1:8000/api/v1/context",
      "expect_stdout": {"type": "contains", "value": "platform"},
      "timeout": 10
    },
    {
      "test_id": "API-003",
      "name": "V1 Context Setting Functionality",
      "description": "Test setting platform context via v1 API",
      "command": "curl -s -X POST http://127.0.0.1:8000/api/v1/context/set -d 'platform=reactnative'",
      "expect_stdout": {"type": "contains", "value": "reactnative"},
      "timeout": 10
    },
    {
      "test_id": "API-004",
      "name": "V1 Registry Listing Functionality",
      "description": "Test v1 registry listing endpoint",
      "command": "curl -s 'http://127.0.0.1:8000/api/v1/registries?platform=reactjs'",
      "expect_stdout": {"type": "contains", "value": "registries"},
      "timeout": 10
    }
  ]
}