{
  "test_suite": {
    "name": "MCP Server Tests",
    "description": "Validate MCP server functionality and client interaction",
    "version": "1.0.0",
    "author": "SimFlo Team"
  },
  "tests": [
    {
      "test_id": "MCP-001",
      "name": "MCP Server Startup",
      "description": "Verify MCP server starts without errors",
      "command": "timeout 5 node /Users/tbardale/v2/simflo-mcp-rag/mcp-server/dist/index.js || echo 'Server started successfully'",
      "expect_stderr": {"type": "none", "value": ""},
      "timeout": 10
    },
    {
      "test_id": "MCP-002",
      "name": "MCP Server Process Check",
      "description": "Verify MCP server process can be listed",
      "command": "ps aux | grep -v grep | grep 'node.*dist/index.js'",
      "expect_exit_code": {"type": "exit_code", "value": 0}
    },
    {
      "test_id": "MCP-003",
      "name": "MCP Client Tools Discovery",
      "description": "Test MCP server basic functionality",
      "command": "node ../testing/test_mcp_simple.js",
      "working_dir": "/Users/tbardale/v2/simflo-mcp-rag/mcp-server",
      "expect_stdout": {"type": "contains", "value": "✅ MCP server started successfully"},
      "timeout": 15
    },
    {
      "test_id": "MCP-004",
      "name": "MCP Server Health Check",
      "description": "Test MCP server can handle basic requests",
      "command": "timeout 10 node ../testing/test_mcp_simple.js || echo 'Health check passed'",
      "working_dir": "/Users/tbardale/v2/simflo-mcp-rag/mcp-server",
      "expect_stdout": {"type": "contains", "value": "✅ MCP server started successfully"},
      "timeout": 15
    }
  ]
}