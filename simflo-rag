#!/bin/bash

# SimFlo MCP RAG - Simple CLI Tool
# Usage: ./simflo-rag --start|--stop|--build

case "$1" in
    --start)
        echo "🚀 Starting SimFlo RAG server..."
        cd data-pipeline
        python3 api_server.py
        ;;
    --stop)
        echo "🛑 Stopping SimFlo RAG server..."
        pkill -f "python3 api_server.py"
        echo "Server stopped"
        ;;
    --build)
        echo "🔨 Rebuilding vector stores..."
        python3 scripts/rebuild_vector_stores.py
        ;;
    --status)
        if pgrep -f "python3 api_server.py" > /dev/null; then
            echo "✅ Server is running"
            curl -s http://localhost:8000/health | jq . 2>/dev/null || echo "Health check unavailable"
        else
            echo "❌ Server is not running"
        fi
        ;;
    *)
        echo "Usage: ./simflo-rag --start|--stop|--build|--status"
        echo "  --start   Start the RAG server"
        echo "  --stop    Stop the RAG server"
        echo "  --build   Rebuild vector stores"
        echo "  --status  Check server status"
        exit 1
        ;;
esac